# devnet.deftrack -- example environment
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST stay that way:
# this repository is public.
#
# WRITE THIS FILE WITH LF LINE ENDINGS. A CRLF .env breaks `set -a; . ./.env`
# on Linux with `$'\r': command not found`.

# ── runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=4100

# Comma-separated list. Empty in development (the Vite dev server proxies).
CORS_ORIGINS=

# ── database ──────────────────────────────────────────────────────────────
# Devnet database only. Never point this at the production deftrack MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/deftrack_devnet

# ── devnet node RPC ───────────────────────────────────────────────────────
# defcond is started with `-devnet=defcon-q60`; -port and -rpcport are
# mandatory in devnet mode. RPC is bound to 127.0.0.1 -- reach it over an SSH
# tunnel during local development, never expose it.
RPC_HOST=127.0.0.1
RPC_PORT=CHANGEME
RPC_USER=CHANGEME
RPC_PASS=CHANGEME
RPC_TIMEOUT_MS=10000

# ── collectors (Phase 1) ──────────────────────────────────────────────────
# QUORUM_POLL_INTERVAL_MS=60000
# MN_POLL_INTERVAL_MS=60000
# SYNC_TX_CONCURRENCY=6
# Empty disables ZMQ and uses the fast ChainLock poll fallback. Keep the node's
# unauthenticated publisher on localhost; the explorer runs beside it.
# Matching defcond flags on that host:
# -zmqpubhashblock=tcp://127.0.0.1:28332
# -zmqpubhashchainlock=tcp://127.0.0.1:28332
# -zmqpubhashtx=tcp://127.0.0.1:28332
# -zmqpubsequence=tcp://127.0.0.1:28332
# ZMQ_ENDPOINT=tcp://127.0.0.1:28332
# CHAINLOCK_POLL_INTERVAL_MS=10000
# CHAINLOCK_RECONCILE_INTERVAL_MS=300000

# ── admin ─────────────────────────────────────────────────────────────────
# Guards the DevnetOperator onboarding endpoint. Generate with:
#   openssl rand -hex 32
# ADMIN_API_KEY=CHANGEME

# Simulator Control API (CLI/server only). All three identity pins are
# mandatory before draft creation; an empty value makes the simulator fail
# closed. The role is server-owned, never accepted from an HTTP header/body.
# SIMULATION_ADMIN_ACTOR_ID=devnet-operator
# SIMULATION_ADMIN_ROLE=operator
# SIMULATION_EXPECTED_CHAIN=devnet-defcon-q60
# SIMULATION_EXPECTED_GENESIS_HASH=CHANGEME_64_HEX
# The exact version string the day-8 host wrapper reports. A hard precondition
# for a LIVE run: unset, preflight fails closed with a clear error naming this
# variable, rather than blaming the targets for a version mismatch. Dry-run
# validation does not require it.
# SIMULATION_EXPECTED_WRAPPER_VERSION=CHANGEME
# The live lab executor is off unless BOTH are set. It only ever acts on the
# local Docker lab (the control service refuses any non-regtest run), applying
# netem faults through the node-local wrapper's command queue. Leave disabled on
# any host that is not the lab: the control slots then stay fail-closed.
# SIMULATION_LAB_EXECUTOR_ENABLED=false
# SIMULATION_LAB_WRAPPER_COMMANDS=/var/lib/netem-wrapper/commands
# SIMULATION_LAB_DOCKER_BIN=docker
# The only Compose project whose containers may be faulted. A declared target's
# hostRef becomes a container name verbatim, so without this any container
# sharing the lab host -- another project's database, your own service -- could
# be declared as a target and stopped. Empty refuses every container.
# SIMULATION_LAB_CONTAINER_PROJECT=defcon-finality-lab
# Where the wrapper publishes its heartbeat, and where the live preflight reads
# recovery evidence from. Unset means a live run has no recovery evidence and
# fails recovery-ready -- fail-closed, and for the true reason. The wrapper's own
# NETEM_WRAPPER_HEARTBEAT must name the same file, and its NETEM_WRAPPER_VERSION
# must equal SIMULATION_EXPECTED_WRAPPER_VERSION or every target reads as
# unrecoverable.
# SIMULATION_LAB_WRAPPER_HEARTBEAT=/var/lib/netem-wrapper/heartbeat.json
#
# The simulator lab runs as its OWN process (npm run start:lab -w server), against
# the lab chain and its OWN database. It starts nothing that reads or writes the
# devnet record: no sync, no pollers, no ZMQ, no public routes.
#
# LAB_MONGODB_URI has no default on purpose -- a default is how the lab would
# silently inherit the explorer's database, and a regtest run filed among devnet
# ones is a corruption of the record no later query can undo. The lab refuses to
# start if this is unset, equals MONGODB_URI, or names the same database.
# LAB_MONGODB_URI=mongodb://devnet_app:CHANGEME@127.0.0.1:27017/deftrack_lab?authSource=admin
# LAB_HOST=127.0.0.1
# LAB_PORT=4200

# Shared by the per-host observer agents. Empty disables the ingest endpoint
# outright rather than leaving it open. Rotate it if a host is ever rebuilt:
# eight machines hold this token, so it is the credential most likely to leak.
INGEST_TOKEN=

# --- Admin panel browser sign-in (day 10). All empty = off. ---------------------
# The key path above refuses cookies and Origins so the key never reaches a
# browser; this is the separate door a panel signs in through.
# Header the reverse proxy asserts the subject in (Cloudflare Access shown):
ADMIN_IDENTITY_HEADER=
# Socket peers allowed to assert it (the proxy), comma-separated. Never trust
# X-Forwarded-For here; this is matched on the real peer address.
ADMIN_TRUSTED_PROXIES=
# Who may sign in and as what: {"alice@example.org":"safety-admin","bob@example.org":"operator"}
ADMIN_IDENTITIES=
ADMIN_SESSION_TTL_MS=28800000
# Only a lab on plain loopback http may set this to false.
ADMIN_COOKIE_SECURE=true
