# devnet.deftrack -- example environment
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST stay that way:
# this repository is public.
#
# WRITE THIS FILE WITH LF LINE ENDINGS. A CRLF .env breaks `set -a; . ./.env`
# on Linux with `$'\r': command not found`.

# ── runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=4100

# Comma-separated list. Empty in development (the Vite dev server proxies).
CORS_ORIGINS=

# ── database ──────────────────────────────────────────────────────────────
# Devnet database only. Never point this at the production deftrack MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/deftrack_devnet

# ── devnet node RPC ───────────────────────────────────────────────────────
# defcond is started with `-devnet=defcon-q60`; -port and -rpcport are
# mandatory in devnet mode. RPC is bound to 127.0.0.1 -- reach it over an SSH
# tunnel during local development, never expose it.
RPC_HOST=127.0.0.1
RPC_PORT=CHANGEME
RPC_USER=CHANGEME
RPC_PASS=CHANGEME
RPC_TIMEOUT_MS=10000

# ── collectors (Phase 1) ──────────────────────────────────────────────────
# QUORUM_POLL_INTERVAL_MS=60000
# MN_POLL_INTERVAL_MS=60000
# SYNC_TX_CONCURRENCY=6
# Empty disables ZMQ and uses the fast ChainLock poll fallback. Keep the node's
# unauthenticated publisher on localhost; the explorer runs beside it.
# Matching defcond flags on that host:
# -zmqpubhashblock=tcp://127.0.0.1:28332
# -zmqpubhashchainlock=tcp://127.0.0.1:28332
# -zmqpubhashtx=tcp://127.0.0.1:28332
# -zmqpubsequence=tcp://127.0.0.1:28332
# ZMQ_ENDPOINT=tcp://127.0.0.1:28332
# CHAINLOCK_POLL_INTERVAL_MS=10000
# CHAINLOCK_RECONCILE_INTERVAL_MS=300000

# ── admin ─────────────────────────────────────────────────────────────────
# Guards the DevnetOperator onboarding endpoint. Generate with:
#   openssl rand -hex 32
# ADMIN_API_KEY=CHANGEME
