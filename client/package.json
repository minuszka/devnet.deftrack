{
  "name": "@devnet-deftrack/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:browser": "playwright install chromium",
    "test:csp": "playwright test --config playwright.csp.config.ts"
  },
  "dependencies": {
    "@devnet-deftrack/shared": "*",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.7",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
